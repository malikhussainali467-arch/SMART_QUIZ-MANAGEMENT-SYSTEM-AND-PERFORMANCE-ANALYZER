{
  "name": "smart-quiz",
  "version": "1.0.0",
  "description": "Smart Quiz Management and Performance Analysis System (university project)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
