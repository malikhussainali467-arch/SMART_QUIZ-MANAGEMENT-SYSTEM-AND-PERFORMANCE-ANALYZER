# Copy this file to ".env" only if you want to change something.
# Everything works without it.

PORT=5000

# SQLite database file path. Saved in ./data so data survives restarts.
DB_STORAGE=data/quiz.sqlite

# Secret used to sign login tokens. Change it for anything beyond a demo.
JWT_SECRET=smart-quiz-dev-secret-change-me

# Teachers must enter this code on the Register page.
TEACHER_CODE=TEACHER2026

# Fill an empty database with demo users, questions and quizzes (true / false)
SEED_DEMO=true
